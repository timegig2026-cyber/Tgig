rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email.lower() == 'timegig2026@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    function isValidUserProfile(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('role' in data) || (data.role in ['seeker', 'provider'])) &&
             (!('createdAt' in data) || (data.createdAt is string)) &&
             (!('updatedAt' in data) || (data.updatedAt is string)) &&
             (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 100)) &&
             (!('middleName' in data) || (data.middleName is string && data.middleName.size() <= 100)) &&
             (!('surname' in data) || (data.surname is string && data.surname.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('socialLinks' in data) || (data.socialLinks is list)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
             (!('photoURL' in data) || (data.photoURL == null || data.photoURL is string)) &&
             (!('idDocument' in data) || (data.idDocument is string)) &&
             (!('isTenantRequest' in data) || (data.isTenantRequest is bool)) &&
             (!('isTenantApproved' in data) || (data.isTenantApproved is bool)) &&
             (!('isTenantDisabled' in data) || (data.isTenantDisabled is bool)) &&
             (!('monthlySubscriptionFee' in data) || (data.monthlySubscriptionFee is number)) &&
             (!('isAdmin' in data) || (data.isAdmin is bool)) &&
             (!('subscriptionActive' in data) || (data.subscriptionActive is bool)) &&
             (!('subscriptionExpiresAt' in data) || (data.subscriptionExpiresAt is string)) &&
             (!('branding' in data) || (data.branding is map)) &&
             (!('tenantId' in data) || (data.tenantId is string)) &&
             (!('tenantApproved' in data) || (data.tenantApproved is bool)) &&
             (!('userSubscriptionActive' in data) || (data.userSubscriptionActive is bool)) &&
             (!('userSubscriptionExpiresAt' in data) || (data.userSubscriptionExpiresAt is string)) &&
             (!('tenantAgreementAccepted' in data) || (data.tenantAgreementAccepted is bool)) &&
             (!('tenantAgreementAcceptedAt' in data) || (data.tenantAgreementAcceptedAt == null || data.tenantAgreementAcceptedAt is string)) &&
             (!('bankDetails' in data) || (data.bankDetails is map));
    }

    match /users/{userId} {
      allow get: if isSignedIn() || (resource != null && (resource.data.get('role', 'seeker') == 'seeker' || resource.data.get('isTenantApproved', false) == true));
      allow list: if (resource.data.get('role', 'seeker') == 'seeker') || (isSignedIn() && (resource.data.get('tenantId', '') == request.auth.uid || isAdmin()));
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == userId && (!('isAdmin' in incoming()) || incoming().isAdmin == false);
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == userId && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isTenantApproved', 'isTenantDisabled', 'subscriptionActive', 'subscriptionExpiresAt'])) || isAdmin());
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isTenantApproved', 'isTenantRequest', 'isTenantDisabled', 'subscriptionActive', 'subscriptionExpiresAt', 'updatedAt']);
      allow update: if isSignedIn() && resource.data.get('tenantId', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenantApproved', 'userSubscriptionActive', 'userSubscriptionExpiresAt', 'updatedAt']);
    }

    // --- Gigs ---
    function isValidGig(data) {
      return data.keys().hasAll(['gigId', 'title', 'providerId', 'location', 'createdAt']) &&
             data.gigId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.providerId == request.auth.uid &&
             data.location.lat is number && data.location.lng is number &&
             data.createdAt is string &&
             (!('category' in data) || data.category is string) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('price' in data) || data.price is number) &&
             (!('status' in data) || data.status in ['open', 'closed', 'in-progress']) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /gigs/{gigId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidGig(incoming()) && isValidId(gigId);
      allow update: if isSignedIn() && (existing().providerId == request.auth.uid || isAdmin()) && isValidGig(incoming()) &&
                    incoming().gigId == existing().gigId &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && (existing().providerId == request.auth.uid || isAdmin());
    }

    // --- Hires ---
    function isValidHire(data) {
      return data.keys().hasAll(['hireId', 'requesterId', 'seekerId', 'status', 'destination', 'createdAt']) &&
             data.hireId is string &&
             data.requesterId == request.auth.uid &&
             data.seekerId is string &&
             data.requesterId != data.seekerId && // Seekers cannot hire themselves
             data.status in ['pending', 'accepted', 'completed'] &&
             data.destination.lat is number && data.destination.lng is number &&
             data.createdAt is string &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (!('seekerLocation' in data) || (data.seekerLocation.lat is number && data.seekerLocation.lng is number));
    }

    match /hires/{hireId} {
      allow read: if isSignedIn() && (resource.data.requesterId == request.auth.uid || resource.data.seekerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidHire(incoming()) && isValidId(hireId);
      allow update: if isSignedIn() && 
                    (resource.data.requesterId == request.auth.uid || resource.data.seekerId == request.auth.uid || isAdmin()) &&
                    (incoming().status in ['pending', 'accepted', 'completed']) &&
                    incoming().hireId == existing().hireId &&
                    incoming().createdAt == existing().createdAt;
    }

    // --- Gig Applications ---
    function isValidGigApplication(data) {
      return data.keys().hasAll(['applicationId', 'gigId', 'gigOwnerId', 'applicantId', 'status', 'createdAt']) &&
             data.applicationId is string &&
             data.gigId is string &&
             data.gigOwnerId is string &&
             data.applicantId == request.auth.uid &&
             data.applicantId != data.gigOwnerId && // Gig owner cannot apply to their own gigs!
             data.status in ['pending', 'accepted', 'rejected'] &&
             data.createdAt is string &&
             (!('applicantName' in data) || (data.applicantName is string && data.applicantName.size() <= 100)) &&
             (!('applicantPhotoURL' in data) || data.applicantPhotoURL is string) &&
             (!('applicantPhone' in data) || (data.applicantPhone is string && data.applicantPhone.size() <= 30)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /gigApplications/{applicationId} {
      allow read: if isSignedIn() && (resource.data.applicantId == request.auth.uid || resource.data.gigOwnerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidGigApplication(incoming()) && isValidId(applicationId);
      allow update: if isSignedIn() && 
                    (resource.data.gigOwnerId == request.auth.uid || resource.data.applicantId == request.auth.uid || isAdmin()) &&
                    (incoming().status in ['pending', 'accepted', 'rejected']) &&
                    incoming().applicationId == existing().applicationId &&
                    incoming().gigId == existing().gigId &&
                    incoming().gigOwnerId == existing().gigOwnerId &&
                    incoming().applicantId == existing().applicantId &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && (resource.data.applicantId == request.auth.uid || resource.data.gigOwnerId == request.auth.uid || isAdmin());
    }

    // --- Payments ---
    function isValidPayment(data) {
      return data.keys().hasAll(['paymentId', 'userId', 'tenantId', 'proofImage', 'status', 'createdAt']) &&
             data.paymentId is string &&
             data.userId == request.auth.uid &&
             data.tenantId is string &&
             data.status == 'pending' &&
             data.createdAt is string &&
             (!('userDisplayName' in data) || (data.userDisplayName is string && data.userDisplayName.size() <= 100)) &&
             (!('userPhotoURL' in data) || data.userPhotoURL is string) &&
             (!('amount' in data) || data.amount is number) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidPayment(incoming()) && isValidId(paymentId);
      allow update: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin()) &&
                    (incoming().status in ['pending', 'approved', 'rejected']) &&
                    incoming().paymentId == existing().paymentId &&
                    incoming().userId == existing().userId &&
                    incoming().tenantId == existing().tenantId &&
                    incoming().createdAt == existing().createdAt;
    }

    // --- Tenant Subscriptions ---
    function isValidTenantSub(data) {
      return data.keys().hasAll(['subId', 'tenantId', 'proofImage', 'status', 'createdAt']) &&
             data.subId is string &&
             data.tenantId == request.auth.uid &&
             data.status == 'pending' &&
             data.createdAt is string &&
             (!('tenantName' in data) || (data.tenantName is string && data.tenantName.size() <= 100)) &&
             (!('amount' in data) || data.amount is number) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /tenantSubscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTenantSub(incoming()) && isValidId(subId);
      allow update: if isSignedIn() && isAdmin() &&
                    (incoming().status in ['pending', 'approved', 'rejected']) &&
                    incoming().subId == existing().subId &&
                    incoming().tenantId == existing().tenantId &&
                    incoming().createdAt == existing().createdAt;
    }
  }
}
