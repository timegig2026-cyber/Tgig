rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.get('email', '').lower() == 'timegig2026@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    function isValidUserProfile(data) {
      return (data.get('userId', '') is string) &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100) &&
             (data.get('role', 'seeker') in ['seeker', 'provider']) &&
             (data.get('createdAt', '') is string) &&
             (data.get('updatedAt', '') is string) &&
             (data.get('firstName', '') is string) &&
             (data.get('surname', '') is string) &&
             (data.get('phone', '') is string) &&
             (data.get('socialLinks', []) is list) &&
             (data.get('bio', '') is string) &&
             (data.get('photoURL', '') is string) &&
             (data.get('idDocument', '') is string) &&
             (data.get('isTenantRequest', false) is bool) &&
             (data.get('isTenantApproved', false) is bool) &&
             (data.get('isAdmin', false) is bool) &&
             (data.get('subscriptionActive', false) is bool) &&
             (data.get('subscriptionExpiresAt', '') is string) &&
             (data.get('branding', {}) is map);
    }

    match /users/{userId} {
      allow get: if isSignedIn() || (resource != null && resource.data.get('role', 'seeker') == 'seeker');
      allow list: if isSignedIn() && (resource.data.get('role', 'seeker') == 'seeker' || isAdmin());
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == userId;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isTenantApproved', 'isTenantRequest', 'subscriptionActive', 'updatedAt']);
    }

    // --- Gigs ---
    function isValidGig(data) {
      return data.keys().hasAll(['gigId', 'title', 'providerId', 'location', 'createdAt']) &&
             data.gigId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.providerId == request.auth.uid &&
             data.location.lat is number && data.location.lng is number &&
             data.createdAt is string &&
             (data.get('category', 'other') is string) &&
             (data.get('updatedAt', '') is string);
    }

    match /gigs/{gigId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidGig(incoming());
      allow update: if isSignedIn() && existing().providerId == request.auth.uid && isValidGig(incoming()) &&
                    incoming().gigId == existing().gigId &&
                    (incoming().get('createdAt', '') == existing().get('createdAt', ''));
      allow delete: if isSignedIn() && existing().providerId == request.auth.uid;
    }

    // --- Hires ---
    function isValidHire(data) {
      return data.keys().hasAll(['hireId', 'requesterId', 'seekerId', 'status', 'destination', 'createdAt']) &&
             data.hireId is string &&
             data.requesterId == request.auth.uid &&
             data.status in ['pending', 'accepted', 'completed'] &&
             data.destination.lat is number && data.destination.lng is number &&
             data.createdAt is string &&
             (data.get('updatedAt', '') is string);
    }

    match /hires/{hireId} {
      allow read: if isSignedIn() && (resource.data.requesterId == request.auth.uid || resource.data.seekerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidHire(incoming()) && isValidId(hireId);
      allow update: if isSignedIn() && 
                    (resource.data.requesterId == request.auth.uid || resource.data.seekerId == request.auth.uid || isAdmin()) &&
                    (incoming().status in ['pending', 'accepted', 'completed']) &&
                    incoming().hireId == existing().hireId &&
                    (incoming().get('createdAt', '') == existing().get('createdAt', ''));
    }

    // --- Payments ---
    function isValidPayment(data) {
      return data.keys().hasAll(['paymentId', 'userId', 'tenantId', 'proofImage', 'status', 'createdAt']) &&
             data.paymentId is string &&
             data.userId == request.auth.uid &&
             data.tenantId is string &&
             data.status == 'pending' &&
             data.createdAt is string &&
             (data.get('updatedAt', '') is string);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidPayment(incoming()) && isValidId(paymentId);
      allow update: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin()) &&
                    (incoming().status in ['pending', 'approved', 'rejected']) &&
                    incoming().paymentId == existing().paymentId &&
                    incoming().userId == existing().userId &&
                    incoming().tenantId == existing().tenantId &&
                    (incoming().get('createdAt', '') == existing().get('createdAt', ''));
    }

    // --- Tenant Subscriptions ---
    function isValidTenantSub(data) {
      return data.keys().hasAll(['subId', 'tenantId', 'proofImage', 'status', 'createdAt']) &&
             data.subId is string &&
             data.tenantId == request.auth.uid &&
             data.status == 'pending' &&
             data.createdAt is string &&
             (data.get('updatedAt', '') is string);
    }

    match /tenantSubscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTenantSub(incoming()) && isValidId(subId);
      allow update: if isSignedIn() && isAdmin() &&
                    (incoming().status in ['pending', 'approved', 'rejected']) &&
                    incoming().subId == existing().subId &&
                    incoming().tenantId == existing().tenantId &&
                    (incoming().get('createdAt', '') == existing().get('createdAt', ''));
    }
  }
}
