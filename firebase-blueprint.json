{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile information for users and seekers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique ID of the user." },
        "firstName": { "type": "string", "maxLength": 100 },
        "middleName": { "type": "string", "maxLength": 100 },
        "surname": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100, "description": "The display name of the user." },
        "phone": { "type": "string", "maxLength": 20 },
        "socialLinks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "idDocument": { "type": "string", "description": "Base64 encoded ID document." },
        "bio": { "type": "string", "maxLength": 500, "description": "A short bio about the user." },
        "role": { "type": "string", "enum": ["seeker", "provider"], "description": "User's primary role." },
        "photoURL": { "type": "string", "description": "Base64 or URL of the profile picture." },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "isTenantRequest": { "type": "boolean", "description": "Whether the user has requested to be a tenant." },
        "isTenantApproved": { "type": "boolean", "description": "Whether the user's tenant request is approved." },
        "isTenantDisabled": { "type": "boolean", "description": "Whether the tenant account is disabled by admin." },
        "monthlySubscriptionFee": { "type": "number", "description": "Custom monthly subscription fee set by tenant." },
        "isAdmin": { "type": "boolean", "description": "Whether the user is an administrator." },
        "subscriptionActive": { "type": "boolean", "description": "Whether the tenant subscription is active." },
        "subscriptionExpiresAt": { "type": "string", "format": "date-time", "description": "When the tenant subscription expires." },
        "tenantId": { "type": "string", "description": "The ID of the tenant whose link the user joined through." },
        "tenantApproved": { "type": "boolean", "description": "Whether the tenant has approved this user." },
        "userSubscriptionActive": { "type": "boolean", "description": "Whether the user's monthly subscription to the tenant is active." },
        "userSubscriptionExpiresAt": { "type": "string", "format": "date-time", "description": "Expiry date of the user's monthly subscription to the tenant." },
        "tenantAgreementAccepted": { "type": "boolean", "description": "Whether the user has accepted the tenant agreement." },
        "tenantAgreementAcceptedAt": { "type": "string", "format": "date-time", "description": "Timestamp when the tenant agreement was accepted." },
        "trialExpiresAt": { "type": "string", "format": "date-time", "description": "Timestamp when the 30-day trial expires." },
        "lastViewedSeekers": { "type": "string", "format": "date-time", "description": "Timestamp when the user last viewed the seekers list." },
        "lastViewedGigs": { "type": "string", "format": "date-time", "description": "Timestamp when the user last viewed the gigs map." },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "message": { "type": "string" },
              "type": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          },
          "description": "List of user notifications."
        },
        "bankDetails": {
          "type": "object",
          "properties": {
            "bankName": { "type": "string" },
            "accountHolder": { "type": "string" },
            "accountNumber": { "type": "string" },
            "accountType": { "type": "string" },
            "branchCode": { "type": "string" }
          },
          "description": "Tenant banking details for receiving member payments."
        },
        "branding": {
          "type": "object",
          "properties": {
            "appName": { "type": "string" },
            "fontFamily": { "type": "string" },
            "fontSize": { "type": "string" },
            "fontColor": { "type": "string" }
          }
        },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last time user was online." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "role", "createdAt"]
    },
    "Gig": {
      "title": "Gig",
      "description": "A job opportunity or service offered.",
      "type": "object",
      "properties": {
        "gigId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["car wash", "painting", "cleaning", "nanny", "construction", "security", "other"] },
        "description": { "type": "string", "maxLength": 1000 },
        "providerId": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed", "in-progress"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["gigId", "title", "providerId", "location", "createdAt"]
    },
    "Hire": {
      "title": "Hire",
      "description": "Represents a hiring request from a user to a seeker. Seekers cannot hire themselves.",
      "type": "object",
      "properties": {
        "hireId": { "type": "string" },
        "requesterId": { "type": "string" },
        "seekerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed"] },
        "destination": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "seekerLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hireId", "requesterId", "seekerId", "status", "destination", "createdAt"]
    },
    "GigApplication": {
      "title": "Gig Application",
      "description": "Represents an application from a seeker to a gig. Gig owners cannot apply to their own gigs.",
      "type": "object",
      "properties": {
        "applicationId": { "type": "string" },
        "gigId": { "type": "string" },
        "gigOwnerId": { "type": "string" },
        "applicantId": { "type": "string" },
        "applicantName": { "type": "string", "maxLength": 100 },
        "applicantPhotoURL": { "type": "string" },
        "applicantPhone": { "type": "string", "maxLength": 30 },
        "message": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicationId", "gigId", "gigOwnerId", "applicantId", "status", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Proof of payment from a user to a tenant.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string" },
        "userId": { "type": "string", "description": "The user making the payment." },
        "tenantId": { "type": "string", "description": "The tenant receiving the payment." },
        "userDisplayName": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "proofImage": { "type": "string", "description": "Base64 encoded proof of payment image." },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentId", "userId", "tenantId", "proofImage", "status", "createdAt"]
    },
    "TenantSubscription": {
      "title": "Tenant Subscription",
      "description": "Proof of payment for tenant's own monthly subscription.",
      "type": "object",
      "properties": {
        "subId": { "type": "string" },
        "tenantId": { "type": "string" },
        "tenantName": { "type": "string" },
        "proofImage": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subId", "tenantId", "proofImage", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and seeker data."
    },
    "/gigs/{gigId}": {
      "schema": "Gig",
      "description": "Available gigs on the map."
    },
    "/hires/{hireId}": {
      "schema": "Hire",
      "description": "Hiring records between users and seekers."
    },
    "/gigApplications/{applicationId}": {
      "schema": "GigApplication",
      "description": "Gig applications submitted by seekers. Gig owners cannot apply to their own gigs."
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Proof of payment records for tenants."
    },
    "/tenantSubscriptions/{subId}": {
      "schema": "TenantSubscription",
      "description": "Tenant subscription payment records."
    }
  }
}
